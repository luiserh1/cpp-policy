# cpp-policy clang-tidy configuration (LLVM 23). See POLICY.md.
#
# Approach: enable whole check groups, then disable individual checks that are
# noisy or that contradict POLICY.md. Every enabled check is an error.
# Do not edit this file in a consuming project; the build always uses cpp-policy's copy.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  google-runtime-int,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once,
  -readability-identifier-length

# Rationale for the disabled checks:
#   easily-swappable-parameters     flags most functions with two same-typed params
#   magic-numbers (both)            too noisy; named constants are a review matter
#   avoid-do-while                  do/while is fine
#   constant-array-index,
#   avoid-unchecked-container-access operator[] is allowed; library hardening checks it
#   include-cleaner                 unreliable with standard library headers
#   no-recursion                    recursion is allowed
#   misc-non-private-member-vars    duplicate of the cppcoreguidelines check (configured below)
#   use-nodiscard                   would demand [[nodiscard]] on every const getter
#   use-trailing-return-type        style preference, not safety
#   avoid-pragma-once               POLICY.md mandates #pragma once
#   identifier-length               flags i, x, id...

WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(/_deps/|/vcpkg_installed/|/third_party/|/external/)'
FormatStyle: none

CheckOptions:
  # Plain structs (all members public) are fine; mixed/protected data is not.
  cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  # A class may declare only a defaulted virtual destructor without the other four.
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  # Ignoring an error-carrying return value is a bug.
  bugprone-unused-return-value.CheckedReturnTypes: '::std::error_code;::std::error_condition;::std::errc;::std::expected'
