#!/bin/sh
# cpp-policy tidy-files: what the gate will say about the given files, without the tests:
# the format, the audit's rules about one file (length, suppressions, test-case names) and
# clang-tidy, with the policy's configuration (POLICY.md 8). Run it from the project's root
# after editing C++ files, whoever edits them:
#
#   sh tools/hooks/tidy-files src/server/local_server.cpp src/server/local_server.hpp
#   sh tools/hooks/tidy-files --format src/server/local_server.cpp     # formats them instead
#
# A few seconds per file, instead of the whole gate. pre-commit runs it on the staged files.
# Copy unchanged into the project's tools/hooks/ (git runs only files named after its hooks).
set -e

# --format: format the given files instead of checking them.
format=no
if [ "${1:-}" = --format ]; then
    format=yes
    shift
fi
if [ $# -eq 0 ]; then
    echo "usage: sh tools/hooks/tidy-files [--format] <file>..." >&2
    exit 2
fi

# The check presets are per platform, as in the other hooks.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) preset=win-check ;;
    *) preset=check ;;
esac
config=build/$preset/cpp_policy_config.cmake
if [ ! -f "$config" ]; then
    cmake --preset "$preset" >/dev/null
fi
# The policy's copy that the build fetched; its scripts do the work.
policy=$(sed -n 's/^set(POLICY_ROOT \[==\[\(.*\)\]==\])$/\1/p' "$config")
[ -n "$policy" ] || { echo "tidy-files: $config names no POLICY_ROOT" >&2; exit 1; }
# A pin moved since the last configure (a merge, a checkout) leaves the release of before in
# the build folder: its rules would be the ones applied here, and its POLICY.md the one read.
case $policy in
    */_deps/cpp_policy-src)
        pinned=$(sed -n '/cpp-policy\.git/,/GIT_TAG/s/.*GIT_TAG *\([0-9a-f]\{40\}\).*/\1/p' CMakeLists.txt | head -n 1)
        fetched=$(git -C "$policy" rev-parse HEAD 2>/dev/null || true)
        if [ -n "$pinned" ] && [ -n "$fetched" ] && [ "$pinned" != "$fetched" ]; then
            echo "tidy-files: build/$preset holds cpp-policy at $fetched, and CMakeLists.txt pins"
            echo "tidy-files: $pinned; configuring again (cmake --preset $preset)"
            cmake --preset "$preset" >/dev/null
        fi
        ;;
esac

# CMake lists are separated by ";".
files=$(printf '%s;' "$@")
if [ "$format" = yes ]; then
    exec cmake "-DCONFIG=$config" "-DFILES=${files%;}" -DMODE=fix -P "$policy/cmake/scripts/format.cmake"
fi
cmake "-DCONFIG=$config" "-DFILES=${files%;}" -P "$policy/cmake/scripts/tidy_files.cmake"
