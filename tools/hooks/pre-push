#!/bin/sh
# cpp-policy pre-push hook: the full gate (POLICY.md 8).
# Copy unchanged into the project's tools/hooks/ and enable once per clone with:
#   git config core.hooksPath tools/hooks
set -e

# The gate builds the files on disk, but git pushes commits. Refuse to vouch for
# commits with a working folder that differs from them.
changes=$(git status --porcelain)
if [ -n "$changes" ]; then
    echo "pre-push: the working folder has uncommitted changes, so the gate would not"
    echo "test what is being pushed. Commit or stash them first:"
    echo "$changes" | sed 's/^/  /'
    exit 1
fi

# A workflow that failed here and hasn't passed since (the gate's launcher remembers it): the
# check workflow below would not run it again, so the push would carry the failure.
for failed in build/cpp_policy_gate_failed_*; do
    [ -f "$failed" ] || continue
    workflow=${failed#build/cpp_policy_gate_failed_}
    case $workflow in
        check|win-check) continue ;;
    esac
    echo "pre-push: the $workflow workflow failed in this folder and has not passed since."
    echo "pre-push: make it pass first: sh tools/hooks/gate $workflow"
    exit 1
done

# The gate has just passed on this very commit in this folder (the launcher remembers it,
# and only for a folder with nothing uncommitted): the end of a stage runs the gate, and the
# push that follows would only run it again.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) preset=win-check ;;
    *) preset=check ;;
esac
passed=build/cpp_policy_gate_passed_$preset
if [ -f "$passed" ] && [ "$(cat "$passed")" = "$(git rev-parse HEAD)" ]; then
    echo "pre-push: the gate passed on this commit in this folder ($(git rev-parse --short HEAD)); not run again"
    exit 0
fi

# Through the gate's launcher: one gate at a time on the machine, awake, one final line.
sh tools/hooks/gate
