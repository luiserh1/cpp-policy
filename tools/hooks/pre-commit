#!/bin/sh
# cpp-policy pre-commit hook: suppression audit and format check (POLICY.md 8).
# Copy unchanged into the project's tools/hooks/ and enable once per clone with:
#   git config core.hooksPath tools/hooks
set -e

# The checks read the files on disk, but git commits the staged version. Say so
# when the two differ, so a pass or failure isn't mistaken for the commit's.
unstaged=$(git diff --name-only)
if [ -n "$unstaged" ]; then
    echo "pre-commit: warning: checking the working folder; these files have unstaged changes:"
    echo "$unstaged" | sed 's/^/  /'
fi

# The check presets are per platform: `check` is disabled on Windows (Git for
# Windows runs hooks with its own sh, where uname reports MINGW or MSYS).
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) preset=win-check ;;
    *) preset=check ;;
esac
if [ ! -f "build/$preset/CMakeCache.txt" ]; then
    cmake --preset "$preset" >/dev/null
fi
cmake --build --preset "$preset" --target policy-audit policy-format-check
